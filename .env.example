# =============================================================================
# zwave-observatory configuration
# Copy this file to .env and fill in the values. Empty values below are
# secrets you must supply. The .env file is gitignored and docker-ignored.
# =============================================================================

# --- Home Assistant (required) ----------------------------------------------
# Base URL of your Home Assistant instance, for example http://homeassistant.local:8123
# Long-lived access token from Home Assistant (Profile -> Security -> Long-Lived Access Tokens).
HASS_URL=
HASS_TOKEN=

# --- Z-Wave JS Server (required) --------------------------------------------
# WebSocket URL of your zwave-js-server (or the Z-Wave JS add-on via the
# websocket ingress), for example ws://homeassistant.local:3000
# Optional API token if your zwave-js-server requires auth.
ZWJS_WS_URL=
ZWJS_TOKEN=

# --- InfluxDB (required) ----------------------------------------------------
# InfluxDB v2 base URL, organization name, and an API token with read access
# to your Home Assistant / Z-Wave buckets.
INFLUXDB_URL=
INFLUXDB_ORG=
INFLUXDB_TOKEN=

# --- LLM advisor (optional) --------------------------------------------------
# Provider-agnostic advisor. Supported values: anthropic (default) and
# openai_compatible (works with Ollama, llama.cpp server, OpenAI-compatible gateways).
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-5
# API key for the chosen provider. Leave empty to disable the advisor.
LLM_API_KEY=
# Base URL only for openai_compatible / Ollama providers, e.g. http://ollama:11434/v1
LLM_BASE_URL=
# Maximum tokens per advisor request.
LLM_MAX_TOKENS=
# Hard daily cap on total advisor tokens. The advisor stops answering when reached.
LLM_DAILY_TOKEN_CAP=200000

# --- Runtime -----------------------------------------------------------------
# Directory for persistent state (SQLite audit log, caches, secrets.env).
# Inside the container this is /data and is mounted from ./data.
DATA_DIR=/data
# Host port the web UI is served on.
PORT=8088
# Timezone, for example America/Los_Angeles.
TZ=UTC
# Your Docker Hub username, used to resolve the image in docker-compose.yml.
DOCKERHUB_USERNAME=
